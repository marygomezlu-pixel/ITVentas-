
<?php
require_once "../modelos/Compra.php";

$compra = new Compra();
$op = $_GET["op"] ?? "";

switch ($op) {
    case "proveedores":
        header("Content-Type: application/json; charset=utf-8");
        $rspta = $compra->proveedores();
        $data = [];

        while ($reg = $rspta->fetch_assoc()) {
            $data[] = $reg;
        }

        echo json_encode(["data" => $data]);
        break;

    case "articulos":
        header("Content-Type: application/json; charset=utf-8");
        $rspta = $compra->articulos();
        $data = [];

        while ($reg = $rspta->fetch_assoc()) {
            $data[] = $reg;
        }

        echo json_encode(["data" => $data]);
        break;

    case "listar":
        header("Content-Type: application/json; charset=utf-8");
        $rspta = $compra->listar();
        $data = [];

        while ($reg = $rspta->fetch_assoc()) {
            $data[] = $reg;
        }

        echo json_encode(["data" => $data]);
        break;

    case "obtener":
        header("Content-Type: application/json; charset=utf-8");
        $idcompra = (int)($_GET["idcompra"] ?? 0);
        $resultado = $compra->obtener($idcompra);
        echo json_encode($resultado ?: ["error" => "Compra no encontrada."]);
        break;

    case "registrar":
        header("Content-Type: application/json; charset=utf-8");

        $idproveedor = (int)($_POST["idproveedor"] ?? 0);
        $tipo = limpiarCadena($_POST["tipo_comprobante"] ?? "");
        $serie = limpiarCadena($_POST["serie"] ?? "");
        $correlativo = limpiarCadena($_POST["correlativo"] ?? "");
        $observacion = limpiarCadena($_POST["observacion"] ?? "");
        $detalles = json_decode($_POST["detalles"] ?? "[]", true);

        $mensaje = $compra->registrar(
            $idproveedor,
            $tipo,
            $serie,
            $correlativo,
            $observacion,
            $detalles
        );

        echo json_encode(["mensaje" => $mensaje]);
        break;

    case "editar":
        header("Content-Type: application/json; charset=utf-8");

        $idcompra = (int)($_POST["idcompra"] ?? 0);
        $idproveedor = (int)($_POST["idproveedor"] ?? 0);
        $tipo = limpiarCadena($_POST["tipo_comprobante"] ?? "");
        $serie = limpiarCadena($_POST["serie"] ?? "");
        $correlativo = limpiarCadena($_POST["correlativo"] ?? "");
        $observacion = limpiarCadena($_POST["observacion"] ?? "");
        $detalles = json_decode($_POST["detalles"] ?? "[]", true);

        $mensaje = $compra->editar(
            $idcompra,
            $idproveedor,
            $tipo,
            $serie,
            $correlativo,
            $observacion,
            $detalles
        );

        echo json_encode(["mensaje" => $mensaje]);
        break;

    case "anular":
        header("Content-Type: application/json; charset=utf-8");
        $idcompra = (int)($_POST["idcompra"] ?? 0);
        $mensaje = $compra->anular($idcompra);
        echo json_encode(["mensaje" => $mensaje]);
        break;

    default:
        http_response_code(400);
        header("Content-Type: application/json; charset=utf-8");
        echo json_encode(["error" => "Operación no válida."]);
        break;
}
?>
